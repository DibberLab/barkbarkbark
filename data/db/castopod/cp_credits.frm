source=SELECT `person_group`, `person_id`, `full_name`, `person_role`, `podcast_id`, NULL AS `episode_id` FROM `cp_podcasts_persons`\n        INNER JOIN `cp_persons`\n            ON (`person_id`=`cp_persons`.`id`)\n    UNION\n    SELECT `person_group`, `person_id`, `full_name`, `person_role`, cp_episodes_persons.`podcast_id`, `episode_id` FROM `cp_episodes_persons`\n        INNER JOIN `cp_persons`\n            ON (`person_id`=`cp_persons`.`id`)\n        INNER JOIN `cp_episodes`\n            ON (`episode_id`=`cp_episodes`.`id`)\n    WHERE `cp_episodes`.published_at <= UTC_TIMESTAMP()\n    ORDER BY `person_group`, `full_name`, `person_role`, `podcast_id`, `episode_id`
